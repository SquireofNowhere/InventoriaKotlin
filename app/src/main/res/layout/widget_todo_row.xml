<?xml version="1.0" encoding="utf-8"?>
<!-- The tick is an ImageView, not a CheckBox: CheckBox is not a RemoteViews view before API 31. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_todo_check"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="6dp"
        android:src="@drawable/ic_widget_check_empty"
        android:tint="@color/widget_on_surface_variant"
        android:contentDescription="@string/ok"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_todo_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/widget_todo_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_todo_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/widget_dot"
        android:contentDescription="@null"/>
</LinearLayout>
