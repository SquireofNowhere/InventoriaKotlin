<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_collection_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_collection_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface"
            android:textSize="14sp"
            android:singleLine="true"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/widget_collection_item_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12sp"
            android:singleLine="true"
            android:ellipsize="end"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_collection_item_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/widget_chip_background"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:textColor="@color/widget_on_surface"
        android:textSize="12sp"
        android:textStyle="bold"/>
</LinearLayout>
