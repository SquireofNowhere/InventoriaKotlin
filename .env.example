# Copy to .env and fill in from your Firebase project. The real .env is gitignored.
#
# None of these are passwords -- they ship inside the APK and are readable by anyone who
# unpacks it. They are kept out of the repo because they identify the Firebase project, and
# what actually protects your data is the project's security rules, not the secrecy of these
# values. See SECURITY.md.

# OAuth 2.0 Web client ID from Firebase Console -> Authentication -> Sign-in method -> Google
DEFAULT_WEB_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Realtime Database URL, e.g. https://your-project-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Storage bucket, e.g. your-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# Web app only (webApp/). The Firebase *Web* API key from Firebase Console -> Project settings ->
# General -> Web API key. Not a secret either, same as the values above.
FIREBASE_WEB_API_KEY=
