{
  "rules": {
    "invites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.val() === auth.uid || data.child('expiresAt').val() < now)",
        ".validate": "newData.hasChildren(['uid', 'expiresAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > now && newData.val() < now + 172800000"
        }
      }
    },

    "deletedAccounts": {
      "$uid": {
        ".read": "auth != null",
        ".write": "$uid === auth.uid && !data.exists()",
        ".validate": "newData.isNumber()"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid || root.child('users').child($uid).child('sharedWith').child(auth.uid).exists())",
        ".write": "$uid === auth.uid && (!root.child('deletedAccounts').child($uid).exists() || !newData.exists())",

        "sharedWith": {
          "$joinerUid": {
            ".write": "$joinerUid === auth.uid && !root.child('deletedAccounts').child($uid).exists() && root.child('invites').child(newData.val()).child('uid').val() === $uid && root.child('invites').child(newData.val()).child('expiresAt').val() > now",
            ".validate": "newData.isString() && root.child('invites').child(newData.val()).child('uid').val() === $uid && root.child('invites').child(newData.val()).child('expiresAt').val() > now && ($uid === auth.uid || $joinerUid === auth.uid)"
          }
        },

        "items": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "item_links": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "tasks": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "collections": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "collection_items": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "todos": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "task_types": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        },
        "settings": {
          ".write": "auth != null && !root.child('deletedAccounts').child($uid).exists() && root.child('users').child($uid).child('sharedWith').child(auth.uid).exists()"
        }
      }
    }
  }
}
